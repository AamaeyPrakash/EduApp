# Copy this file to `.env` and fill in the values from your Appwrite console.
# These values are compiled into the app, so never put secrets here (the OpenAI key
# belongs in the ask-ai Appwrite Function, not in this file). See README.md for setup.

# Appwrite console → Overview → API endpoint / Project ID
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=

# Appwrite console → Databases: the database ID, and the ID of its UserAccounts table
# (previously `database1Id` and `UserAccountsId` in constants.js)
APPWRITE_DATABASE_ID=
APPWRITE_USER_ACCOUNTS_TABLE_ID=

# Appwrite console → Functions (deploy the code in appwrite/functions first)
APPWRITE_AI_FUNCTION_ID=ask-ai
APPWRITE_DELETE_ACCOUNT_FUNCTION_ID=delete-account

# Public page that completes password resets (web/reset-password). Its hostname must be
# added as a Web platform in Appwrite. Leave empty to hide "Forgot password?".
PASSWORD_RESET_URL=

# Public privacy policy page. Both app stores require one.
PRIVACY_POLICY_URL=

# Shown to users who need help (optional)
SUPPORT_EMAIL=
